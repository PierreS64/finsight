# For a real Supabase environment, copy to .env and fill locally.
DATABASE_URL=jdbc:postgresql://YOUR_DB_HOST:5432/postgres?sslmode=require
DATABASE_USERNAME=YOUR_DB_USER
DATABASE_PASSWORD=YOUR_DB_PASSWORD
SUPABASE_ISSUER_URI=https://YOUR_PROJECT.supabase.co/auth/v1
SUPABASE_JWKS_URI=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
LOCAL_POSTGRES_PASSWORD=CHANGE_ME_FOR_LOCAL_ONLY
