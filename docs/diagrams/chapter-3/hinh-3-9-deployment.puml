@startuml
left to right direction
skinparam backgroundColor #FFFFFF
skinparam dpi 220
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #164568
skinparam node {
  BackgroundColor #F5F8FA
  BorderColor #164568
  FontColor #123354
}
skinparam artifact {
  BackgroundColor #EAF6F3
  BorderColor #169B91
  FontColor #123354
}

node "Điện thoại Android" as Phone {
  artifact "FinSight APK" as APK
}

node "Máy demo trong mạng nội bộ" as Demo {
  artifact "Ứng dụng web" as Web
  artifact "FinSight API JAR" as API
  component "Tesseract OCR" as OCR
}

node "Supabase" as Supabase {
  component "Auth" as Auth
  database "PostgreSQL" as DB
}

node "Dịch vụ AI bên ngoài\n(tùy chọn)" as AI {
  component "API diễn giải" as AIAPI
}

APK --> API : API trong mạng nội bộ
Web --> API : API trong mạng nội bộ
APK --> Auth : xác thực
Web --> Auth : xác thực
API --> Auth : JWKS
API --> DB : kết nối riêng
API --> OCR : xử lý ảnh tại máy chủ
API ..> AIAPI : yêu cầu diễn giải tùy chọn
@enduml
