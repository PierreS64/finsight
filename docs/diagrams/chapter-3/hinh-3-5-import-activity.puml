@startuml
skinparam backgroundColor #FFFFFF
skinparam dpi 220
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #164568
skinparam activity {
  BackgroundColor #EAF6F3
  BorderColor #169B91
  FontColor #123354
}

start
:Người dùng chọn tài khoản\nvà tệp CSV/XLSX;
:Web gửi yêu cầu xem trước;
:API kiểm tra JWT, quyền tài khoản\nvà định dạng tệp;
if (Tệp hợp lệ?) then (Có)
  :API phân tích dòng và cảnh báo trùng;\nchưa ghi dữ liệu;
  :Web hiển thị bản xem trước;
  :Người dùng chọn dòng\nvà bổ sung danh mục;
  if (Xác nhận nhập?) then (Có)
    :API kiểm tra lại quyền,\ndữ liệu và dòng trùng;
    if (Toàn bộ dòng chọn hợp lệ?) then (Có)
      :API lưu các dòng được chọn\ntrong một giao dịch CSDL;
      :Web hiển thị kết quả nhập;
    else (Không)
      :Web hiển thị dòng cần sửa;
    endif
  else (Không)
    :Không ghi giao dịch;
  endif
else (Không)
  :Web hiển thị lý do từ chối tệp;
endif
stop
@enduml
