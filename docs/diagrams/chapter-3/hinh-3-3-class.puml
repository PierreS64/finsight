@startuml
left to right direction
hide circle
skinparam backgroundColor #FFFFFF
skinparam dpi 220
skinparam defaultFontName Arial
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam ArrowColor #164568
skinparam class {
  BackgroundColor #EAF6F3
  BorderColor #169B91
  FontColor #123354
}

class UserProfile <<entity>> {
  +userId: UUID
  +displayName: String
  +currencyCode: String
}

class FinancialAccount <<entity>> {
  +id: UUID
  +ownerUserId: UUID
  +name: String
  +accountType: AccountType
  +openingBalance: Decimal
}

class FinancialTransaction <<entity>> {
  +id: UUID
  +ownerUserId: UUID
  +kind: TransactionKind
  +amount: Decimal
  +occurredOn: Date
  +note: String
}

class Category <<entity>> {
  +id: UUID
  +ownerUserId: UUID {nullable}
  +name: String
  +categoryType: TransactionKind
}

class Merchant <<entity>> {
  +id: UUID
  +ownerUserId: UUID
  +name: String
}

class TransactionReceipt <<entity>> {
  +transactionId: UUID
  +imageBytes: Binary
}

class AccountTransfer <<entity>> {
  +id: UUID
  +ownerUserId: UUID
  +amount: Decimal
  +occurredOn: Date
}

UserProfile "1" -- "0..*" FinancialAccount : sở hữu
UserProfile "1" -- "0..*" FinancialTransaction : sở hữu
UserProfile "1" -- "0..*" AccountTransfer : sở hữu
UserProfile "1" -- "0..*" Merchant : sở hữu
UserProfile "0..1" -- "0..*" Category : danh mục riêng

FinancialTransaction "0..*" --> "1" FinancialAccount : ghi vào
FinancialTransaction "0..*" --> "1" Category : phân loại
FinancialTransaction "0..*" --> "0..1" Merchant : phát sinh tại
FinancialTransaction "1" *-- "0..1" TransactionReceipt : đính kèm

AccountTransfer "0..*" --> "1" FinancialAccount : tài khoản nguồn
AccountTransfer "0..*" --> "1" FinancialAccount : tài khoản đích

@enduml
