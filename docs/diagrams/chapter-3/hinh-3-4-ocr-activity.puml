@startuml
skinparam backgroundColor #FFFFFF
skinparam dpi 220
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #164568
skinparam activity {
  BackgroundColor #EAF6F3
  BorderColor #169B91
  FontColor #123354
}

start
:Người dùng chụp hoặc chọn ảnh hóa đơn;
:Android hiển thị ảnh để xem lại;
if (Người dùng chọn quét ảnh?) then (Có)
  :Android gửi ảnh đến API;
  :API kiểm tra JWT và ảnh;
  if (Ảnh hợp lệ và đọc được?) then (Có)
    :Tesseract nhận diện văn bản;
    :API gợi ý ngày, số tiền\nvà nơi giao dịch;
  else (Không)
    :Android thông báo lỗi;\nchuyển sang nhập tay;
  endif
else (Không)
  :Người dùng nhập tay;
endif
:Người dùng kiểm tra, sửa dữ liệu;\nchọn tài khoản và danh mục;
if (Xác nhận lưu?) then (Có)
  :API kiểm tra dữ liệu và quyền sở hữu;
  if (Dữ liệu hợp lệ?) then (Có)
    :API lưu giao dịch;
    if (Có ảnh cần đính kèm?) then (Có)
      :Android tải ảnh cho giao dịch đã tạo;
      :API kiểm tra quyền và lưu ảnh;
    endif
    :Android hiển thị kết quả thực tế;
  else (Không)
    :Android hiển thị lỗi để chỉnh sửa;
  endif
else (Không)
  :Không tạo giao dịch;
endif
stop
@enduml
