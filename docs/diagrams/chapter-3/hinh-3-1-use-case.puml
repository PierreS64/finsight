@startuml
left to right direction
skinparam backgroundColor #FFFFFF
skinparam dpi 220
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #164568
skinparam actor {
  BorderColor #164568
  FontColor #123354
}
skinparam usecase {
  BackgroundColor #EAF6F3
  BorderColor #169B91
  FontColor #123354
}
skinparam rectangle {
  BorderColor #164568
  FontColor #123354
}

actor "Người dùng FinSight" as User

rectangle "Hệ thống FinSight" {
  usecase "Đăng nhập và\nquản lý hồ sơ" as UCAuth
  usecase "Ghi giao dịch\nthu, chi" as UCTx
  usecase "Quản lý tài khoản\nvà chuyển tiền" as UCAccount
  usecase "Quét hóa đơn" as UCOcr
  usecase "Nhập sao kê" as UCImport
  usecase "Xem trước sao kê" as UCPreview
  usecase "Lập kế hoạch\ntài chính" as UCPlan
  usecase "Xem tổng quan\nvà phân tích" as UCAnalysis
  usecase "Hỏi trợ lý AI" as UCAI
}

User -- UCAuth
User -- UCTx
User -- UCAccount
User -- UCImport
User -- UCPlan
User -- UCAnalysis
User -- UCAI

UCOcr .left.> UCTx : <<extend>>
UCImport ..> UCPreview : <<include>>
@enduml
