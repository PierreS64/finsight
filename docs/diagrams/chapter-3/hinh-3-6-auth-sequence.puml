@startuml
skinparam backgroundColor #FFFFFF
skinparam dpi 220
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #164568
skinparam sequence {
  ParticipantBackgroundColor #EAF6F3
  ParticipantBorderColor #169B91
  ParticipantFontColor #123354
  LifeLineBorderColor #164568
  ArrowColor #164568
}

actor "Người dùng" as User
participant "Web/Android" as Client
participant "Supabase Auth" as Auth
participant "FinSight API" as API
participant "Bộ xác minh JWT" as Verifier
database "PostgreSQL" as DB

User -> Client : Nhập thông tin đăng nhập
Client -> Auth : Yêu cầu đăng nhập
Auth --> Client : JWT hoặc lỗi xác thực

alt Đăng nhập thành công
  User -> Client : Mở màn tổng quan
  Client -> API : GET /api/v1/dashboard\nBearer JWT
  API -> Verifier : Kiểm tra chữ ký, issuer,\naudience và hạn token
  opt Chưa có khóa công khai phù hợp trong bộ nhớ đệm
    Verifier -> Auth : Lấy khóa công khai qua JWKS
    Auth --> Verifier : Khóa công khai
  end
  Verifier --> API : Chủ sở hữu đã xác minh
  API -> DB : Đọc dữ liệu theo owner_user_id
  DB --> API : Dữ liệu thuộc chủ sở hữu
  API --> Client : Chỉ số tổng quan
  Client --> User : Hiển thị dữ liệu
else Đăng nhập thất bại
  Client --> User : Hiển thị lỗi đăng nhập
end
@enduml
