@startuml
skinparam backgroundColor #FFFFFF
skinparam dpi 220
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #164568
skinparam sequence {
  ParticipantBackgroundColor #EAF6F3
  ParticipantBorderColor #169B91
  ParticipantFontColor #123354
  LifeLineBorderColor #164568
  ArrowColor #164568
}

actor "Người dùng" as User
participant "Android" as Mobile
participant "FinSight API" as API
participant "Tesseract OCR" as OCR
database "PostgreSQL" as DB

User -> Mobile : Chụp ảnh trong khung
Mobile --> User : Hiển thị ảnh để xem lại
User -> Mobile : Chọn quét hóa đơn
Mobile -> API : POST /receipts/recognize\nJWT + ảnh
API -> API : Xác thực và kiểm tra ảnh
API -> OCR : Nhận diện chữ
OCR --> API : Văn bản nhận diện
API -> API : Gợi ý ngày, số tiền,\nnơi giao dịch và cảnh báo trùng
API --> Mobile : Gợi ý có thể chỉnh sửa
Mobile --> User : Hiển thị biểu mẫu

User -> Mobile : Sửa dữ liệu, chọn tài khoản,\ndanh mục và xác nhận
Mobile -> API : POST /transactions\nJWT + dữ liệu đã xác nhận
API -> API : Kiểm tra quyền sở hữu\nvà dữ liệu
API -> DB : Lưu giao dịch
DB --> API : Mã giao dịch
API --> Mobile : Giao dịch đã tạo

opt Người dùng giữ ảnh đính kèm
  Mobile -> API : Tải ảnh cho giao dịch vừa tạo
  API -> API : Kiểm tra chủ sở hữu giao dịch
  API -> DB : Lưu ảnh hóa đơn riêng tư
  DB --> API : Kết quả lưu ảnh
  API --> Mobile : Trạng thái ảnh đính kèm
end

Mobile --> User : Hiển thị kết quả thực tế
@enduml
